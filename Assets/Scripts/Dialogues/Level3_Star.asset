  dialoguePieces:
  - sentence: "\uC138 \uBC88\uC9F8 '\uACF5\uAC10\uC758 \uBCC4' \uC785\uB2C8\uB2E4"
    choices: []
  - sentence: "\uC804 \uC138\uACC4 \uC131\uC778\uC758 \uC57D 14%\uAC00 \uAE00\uC744
      \uC77D\uACE0 \uC4F8 \uC218 \uC5C6\uC73C\uBA70,"
    choices: []
  - sentence: "\uB2E4\uB978 \uB098\uB77C\uB85C \uC774\uB3D9\uD55C \uC774\uC8FC\uBBFC\uACFC
      \uB09C\uBBFC\uC740 \uC5B8\uC5B4\uC758 \uC7A5\uBCBD\uACFC \uCC28\uBCC4\uB85C
      \uAD50\uC721, \uC758\uB8CC, \uACE0\uC6A9\uC758 \uAE30\uD68C\uC5D0\uC11C \uC81C\uD55C\uC744
      \uBC1B\uAE30\uB3C4 \uD569\uB2C8\uB2E4."
    choices: []
  - sentence: "\uC9C0\uAE08\uD558\uACE0 \uC788\uC73C\uC2E0 \uCCB4\uD5D8\uC740, \uB2E4\uB984\uC744
      \uC874\uC911\uD558\uACE0 \uD568\uAED8 \uC0B4\uC544\uAC00\uB294 \uACF5\uAC10\uC758
      \uC2DC\uC791\uC785\uB2C8\uB2E4."
    choices: []
